{
  "name": "ov-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute ovvo --remote --file schema.sql",
    "build": "tsc --noEmit && node scripts/em-dash-audit.mjs && node scripts/styles-audit.mjs && node scripts/corner-audit.mjs && vite build",
    "check:text": "node scripts/em-dash-audit.mjs",
    "typecheck": "tsc --noEmit",
    "check:phone": "node scripts/old-phone-check.mjs",
    "check:scroll": "node scripts/scroll-audit.mjs",
    "check:install": "node scripts/install-audit.mjs",
    "check:colours": "node scripts/colour-audit.mjs",
    "check:styles": "node scripts/styles-audit.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "vite preview",
    "dev:preview": "bash scripts/dev-preview.sh",
    "after-restore": "bash scripts/after-restore.sh",
    "check:corners": "node scripts/corner-audit.mjs",
    "check:compat": "node scripts/compat-logic-check.mjs",
    "check:compat:browser": "node scripts/compat-check.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "firebase": "^13.1.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.156.0"
  }
}
