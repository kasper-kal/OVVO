{
  "name": "ov-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/em-dash-audit.mjs && vite build",
    "check:text": "node scripts/em-dash-audit.mjs",
    "typecheck": "tsc --noEmit",
    "check:phone": "node scripts/old-phone-check.mjs",
    "check:scroll": "node scripts/scroll-audit.mjs",
    "check:install": "node scripts/install-audit.mjs",
    "check:colours": "node scripts/colour-audit.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "vite preview",
    "dev:preview": "bash scripts/dev-preview.sh",
    "after-restore": "bash scripts/after-restore.sh"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
